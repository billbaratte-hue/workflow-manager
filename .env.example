# Server & Network Configuration
PORT=3000
NODE_ENV=production
JWT_SECRET=super_secret_jwt_key_change_in_production_nis2

# Database Configuration (Multi-Engine Adapter: 'sqlite' | 'mariadb')
DB_ENGINE=sqlite
# For MariaDB / MySQL:
# DB_ENGINE=mariadb
# DB_HOST=localhost
# DB_PORT=3306
# DB_NAME=workflow_db
# DB_USER=workflow_user
# DB_PASSWORD=workflow_password

# For SQLite:
SQLITE_DB_PATH=portal.db

# Application Public URL
APP_URL="http://localhost:3000"
